<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imageSmsIcon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@android:drawable/ic_dialog_info"
        android:contentDescription="SMS Notifications"
        android:tint="#4A6FA5"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textSmsTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Low stock alerts"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2D3142"
        android:gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/imageSmsIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textSmsDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="TagTalk can text you when an item hits zero so you can reorder before it becomes a problem.\n\nAllow or skip below. The app works either way."
        android:textSize="15sp"
        android:textColor="#6B7280"
        android:lineSpacingMultiplier="1.5"
        android:gravity="center"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Example alert card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSmsExample"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="0dp"
        app:strokeColor="#E5E7EB"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXAMPLE ALERT"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:textColor="#9CA3AF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TagTalk: Printer Paper is out of stock. Time to reorder."
                android:textSize="14sp"
                android:textColor="#2D3142"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.3"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/textSmsPermissionStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:gravity="center"
        android:textColor="#4A6FA5"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardSmsExample"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAllowSms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Allow SMS Alerts"
        android:textSize="15sp"
        android:padding="14dp"
        android:layout_marginTop="24dp"
        app:backgroundTint="#4A6FA5"
        app:layout_constraintTop_toBottomOf="@id/textSmsPermissionStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonDenySms"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Skip for Now"
        android:textSize="15sp"
        android:textColor="#6B7280"
        android:padding="14dp"
        android:layout_marginTop="10dp"
        app:strokeColor="#D1D5DB"
        app:layout_constraintTop_toBottomOf="@id/buttonAllowSms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonContinueToApp"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Continue to Inventory"
        android:textSize="13sp"
        android:textColor="#9CA3AF"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/buttonDenySms"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
